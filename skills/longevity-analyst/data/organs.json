  "calculators": {
    "egfr": {
      "label_zh": "估算肾小球滤过率 eGFR（CKD-EPI 2021，肌酐）",
      "unit": "mL/min/1.73m²",
      "citation": "Inker LA et al. New Creatinine- and Cystatin C-Based Equations to Estimate GFR without Race. NEJM 2021",
      "doi": "10.1056/NEJMoa2102953",
      "stage_citation": "KDIGO 2012 CKD guideline, GFR categories G1-G5"
    },
    "fib4": {
      "label_zh": "FIB-4 肝纤维化指数",
      "unit": "",
      "citation": "Sterling RK et al. Hepatology 2006 (formula); Shah AG et al. Clin Gastroenterol Hepatol 2009 (NAFLD cut-offs 1.30/2.67); McPherson S et al. Am J Gastroenterol 2017 (age ≥65 lower cut-off 2.0)",
      "doi": "10.1002/hep.21178; 10.1016/j.cgh.2009.05.033; 10.1038/ajg.2016.453",
      "note_zh": "界值来自脂肪肝和慢性肝炎人群的排除性筛查研究；只是提示，不是诊断"
    },
    "tyg": {
      "label_zh": "TyG 指数（甘油三酯-血糖，胰岛素抵抗替代指标）",
      "unit": "",
      "citation": "Simental-Mendía LE et al. Metab Syndr Relat Disord 2008",
      "doi": "10.1089/met.2008.0034",
      "note_zh": "没有全人群通用的切点，只作描述"
    },
    "aip": {
      "label_zh": "血浆致动脉硬化指数 AIP = log10(TG/HDL-C)",
      "unit": "",
      "citation": "Dobiásová M, Frohlich J. Clin Biochem 2001",
      "doi": "10.1016/s0009-9120(01)00263-6",
      "note_zh": "只作描述，不给风险分层"
    }
  },
